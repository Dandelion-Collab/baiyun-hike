# 复制成 .env 后填写；.env 已在 .gitignore 中，不要提交

# 高德：Web 服务 Key（服务端调用：坐标校正、路线规划、静态地图）
AMAP_KEY=

# 高德：Web 端 JS API Key + 安全密钥（前端卫星地图展示）
AMAP_JS_KEY=
AMAP_SECURITY_CODE=

# 大模型（如需接入复核）
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=

# Streamlit（界面服务）
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true